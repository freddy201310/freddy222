# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Vercel → Storage → Neon sets this for you)
DATABASE_URL="postgresql://haven:haven@localhost:5432/haven"

# Long random string that encrypts two-step sign-in secrets. Never change it after launch.
# Generate: openssl rand -base64 48
APP_SECRET=""

# Shared secret for /api/cron/maintenance (also add it as a GitHub repository secret)
CRON_SECRET=""

# Public address of the site, used in emails and payment redirects
APP_URL="http://localhost:3000"

# ── Your business (shown on the Privacy Policy and Terms) ───────────────────
COMPANY_NAME="Haven"
CONTACT_EMAIL=""
COMPANY_ADDRESS=""
LEGAL_EFFECTIVE_DATE=""

# ── Email (https://resend.com) — password resets and alerts ─────────────────
RESEND_API_KEY=""
EMAIL_FROM="Haven <alerts@yourdomain.com>"

# ── Text messages (https://twilio.com) — urgent alerts ──────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Payments (https://stripe.com) — leave empty to keep Haven free ──────────
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PRICE_LABEL=""   # e.g. "$7.99 a month"

# ── Error tracking (https://sentry.io) ──────────────────────────────────────
SENTRY_DSN=""

# Set to "true" once the Haven Kids phone apps are in the App Store and Google Play
NEXT_PUBLIC_PHONE_APPS_LIVE=""
