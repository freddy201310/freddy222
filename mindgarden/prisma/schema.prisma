// MindGarden data model.
// Every user-owned table cascades on user deletion so "delete my account" removes everything.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  onboarded       Boolean  @default(false)
  interests       String[] @default([])
  companionTone   String   @default("warm") // warm | direct | playful | calm
  aiMemoryEnabled Boolean  @default(true) // may the companion learn from conversations?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions      Session[]
  conversations Conversation[]
  manualEntries ManualEntry[]
  journal       JournalEntry[]
  moods         MoodLog[]
  happyPlace    HappyPlace?
  futureSelf    FutureSelf?
  letters       Letter[]
  daily         DailyContent[]
  resets        ResetPlan[]
}

model Session {
  id        String   @id // sha256 of the cookie token; the raw token is never stored
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New conversation")
  mode      String    @default("companion") // companion | future-me
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

enum Rating {
  HELPFUL
  NOT_HELPFUL
  LOVED_IT
  DOESNT_FIT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  rating         Rating?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ManualCategory {
  GOAL
  VALUE
  MOTIVATOR
  STRESSOR
  HABIT
  HELPFUL_ACTIVITY
  INSIGHT
  MOOD_BOOSTER
  FOCUS_BOOSTER
  SETBACK
  SUCCESS
}

model ManualEntry {
  id        String         @id @default(cuid())
  userId    String
  category  ManualCategory
  content   String
  source    String         @default("user") // user | companion | journal | reset | checkin
  strength  Int            @default(1) // how often this has been observed / confirmed
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

enum JournalMode {
  BRAIN_DUMP
  GRATITUDE
  DAILY_REFLECTION
  GOAL_TRACKING
  PERSONAL_GROWTH
}

model JournalEntry {
  id        String      @id @default(cuid())
  userId    String
  mode      JournalMode
  title     String?
  content   String
  prompt    String?
  aiSummary String?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD, one check-in per day (latest wins)
  mood      Int // 1-5
  energy    Int
  stress    Int
  focus     Int
  sleep     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model HappyPlace {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String   @default("My Happy Place")
  scene       String   @default("garden") // beach | forest | garden | cabin | mountain | fantasy
  palette     String   @default("dawn") // dawn | dusk | mist | meadow | aurora
  weather     String   @default("clear") // clear | rain | snow | fireflies | breeze
  sound       String   @default("none") // none | rain | waves | wind | fire | brook
  music       String   @default("none") // none | drone | chimes
  pet         String   @default("none") // none | cat | dog | fox | bird | bunny | dragon
  decorations String[] @default([])
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FutureSelf {
  id          String   @id @default(cuid())
  userId      String   @unique
  horizon     String   @default("5 years") // how far ahead
  whoBecome   String   @default("")
  habits      String   @default("")
  goals       String   @default("")
  admire      String   @default("")
  values      String   @default("")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Letter {
  id          String    @id @default(cuid())
  userId      String
  recipient   String    @default("self") // self | goal | milestone
  subject     String
  body        String
  deliverAt   DateTime
  deliveredAt DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, deliverAt])
  @@index([userId, deliverAt])
}

model DailyContent {
  id            String   @id @default(cuid())
  userId        String
  day           String // YYYY-MM-DD
  thought       String
  thoughtSource String?
  question      String
  encouragement String
  challenge     String
  challengeDone Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model ResetPlan {
  id        String   @id @default(cuid())
  userId    String
  feeling   String
  steps     Json // ResetStep[]
  helped    Boolean?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
